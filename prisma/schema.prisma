// ===================================================================
// CALENDIO - ENTERPRISE PRISMA SCHEMA
// 100% Free Appointment Scheduling & Meeting Management Platform
// ===================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// -------------------------------------------------------------------
// ENUMS
// -------------------------------------------------------------------

enum UserRole {
  USER
  TEAM_MEMBER
  ADMIN
}

enum LocationType {
  GOOGLE_MEET
  ZOOM
  MS_TEAMS
  MS_TEAMS_PERSONAL
  WEBEX
  GOTO_MEETING
  AROUND
  WHEREBY
  CUSTOM
  PHONE_CALL
  IN_PERSON
}

enum SchedulingType {
  ONE_ON_ONE
  GROUP
  ROUND_ROBIN
  COLLECTIVE
}

enum BookingStatus {
  PENDING
  CONFIRMED
  RESCHEDULED
  CANCELLED
  COMPLETED
}

enum TeamRole {
  OWNER
  ADMIN
  MEMBER
}

enum NotificationType {
  EMAIL
  SMS
  IN_APP
  PUSH
}

enum TriggerType {
  BOOKING_CREATED
  BOOKING_RESCHEDULED
  BOOKING_CANCELLED
  BEFORE_MEETING
  AFTER_MEETING
}

enum ActionType {
  SEND_EMAIL
  SEND_SMS
  SEND_WEBHOOK
  CREATE_CALENDAR_EVENT
  ADD_CONTACT_NOTE
}

enum IntegrationType {
  GOOGLE_CALENDAR
  OUTLOOK_CALENDAR
  APPLE_CALENDAR
  ZOOM
  GOOGLE_MEET
  MICROSOFT_TEAMS
  SLACK
  ZAPIER
  HUBSPOT
}

// -------------------------------------------------------------------
// 1. AUTHENTICATION & USER MANAGEMENT
// -------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  password      String?
  image         String?
  role          UserRole  @default(USER)
  timeZone      String    @default("Asia/Kolkata")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  profile       Profile?
  accounts      Account[]
  sessions      Session[]
  eventTypes    EventType[]
  availabilities Availability[]
  dateOverrides DateOverride[]
  bookings      Booking[]       @relation("HostBookings")
  meetings      Meeting[]
  calendars     Calendar[]
  teamMembers   TeamMember[]
  ownedTeams    Team[]          @relation("TeamOwner")
  contacts      Contact[]
  notifications Notification[]
  routingForms  RoutingForm[]
  automations   Automation[]
  integrations  Integration[]
  webhooks      Webhook[]
  auditLogs     AuditLog[]

  @@index([email])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// -------------------------------------------------------------------
// 2. PROFILE & BRANDING
// -------------------------------------------------------------------

model Profile {
  id           String   @id @default(cuid())
  userId       String   @unique
  username     String   @unique
  bio          String?  @db.Text
  company      String?
  phone        String?
  brandColor   String   @default("#0069FF") // Calendly Premium Blue
  avatarUrl    String?
  customDomain String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([username])
}

// -------------------------------------------------------------------
// 3. CALENDAR CONNECTION & TWO-WAY SYNC
// -------------------------------------------------------------------

model Calendar {
  id           String          @id @default(cuid())
  userId       String
  provider     IntegrationType
  accountEmail String
  accessToken  String          @db.Text
  refreshToken String?         @db.Text
  isPrimary    Boolean         @default(false)
  checkConflicts Boolean       @default(true)
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------------------------------------------------
// 4. AVAILABILITY MANAGEMENT
// -------------------------------------------------------------------

model Availability {
  id              String   @id @default(cuid())
  userId          String
  dayOfWeek       Int      // 0 = Sunday, 1 = Monday ... 6 = Saturday
  startTime       String   // Format: "09:00"
  endTime         String   // Format: "17:00"
  isAvailable     Boolean  @default(true)
  bufferBeforeMin Int      @default(0)   // Minutes before meeting
  bufferAfterMin  Int      @default(15)  // Minutes after meeting
  minNoticeHours  Int      @default(2)   // Minimum notice in hours
  maxBookingsPerDay Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, dayOfWeek])
}

model DateOverride {
  id          String   @id @default(cuid())
  userId      String
  date        DateTime @db.Date // Specific Date
  startTime   String?  // If null, date is fully blocked (Vacation / Holiday)
  endTime     String?
  isBlocked   Boolean  @default(true)
  reason      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// -------------------------------------------------------------------
// 5. EVENT TYPE MANAGEMENT
// -------------------------------------------------------------------

model EventType {
  id              String         @id @default(cuid())
  userId          String
  teamId          String?
  title           String         // e.g. "30 Min Discovery Call"
  slug            String         // e.g. "30min"
  description     String?        @db.Text
  duration        Int            @default(30) // in minutes
  color           String         @default("#0069FF")
  schedulingType  SchedulingType @default(ONE_ON_ONE)
  locationType    LocationType   @default(GOOGLE_MEET)
  locationUrl     String?
  isPrivate       Boolean        @default(false)
  isActive        Boolean        @default(true)
  maxParticipants Int            @default(1) // For group webinar style
  customQuestions Json?          // Dynamic fields array [{ id, label, required, type }]
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  team     Team?     @relation(fields: [teamId], references: [id], onDelete: SetNull)
  bookings Booking[]

  @@unique([userId, slug])
  @@index([userId, isActive])
}

// -------------------------------------------------------------------
// 6. BOOKINGS & APPOINTMENT SCHEDULING
// -------------------------------------------------------------------

model Booking {
  id              String        @id @default(cuid())
  uid             String        @unique @default(uuid()) // Secure public lookup token
  eventTypeId     String
  hostId          String
  startTime       DateTime
  endTime         DateTime
  status          BookingStatus @default(CONFIRMED)
  guestName       String
  guestEmail      String
  guestNotes      String?       @db.Text
  guestTimeZone   String        @default("UTC")
  customResponses Json?         // Answers to eventType.customQuestions
  meetingUrl      String?
  locationType    LocationType?
  locationDetails Json?
  cancelReason    String?
  rescheduledFrom String?       // Previous booking uid
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  eventType EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  host      User      @relation("HostBookings", fields: [hostId], references: [id], onDelete: Cascade)
  meeting   Meeting?

  @@index([hostId, startTime])
  @@index([guestEmail])
  @@index([uid])
}

// -------------------------------------------------------------------
// 7. MEETING MANAGEMENT & AI ASSISTANT
// -------------------------------------------------------------------

model Meeting {
  id           String    @id @default(cuid())
  bookingId    String    @unique
  hostId       String
  recordingUrl String?
  transcript   String?   @db.Text
  aiSummary    String?   @db.Text
  actionItems  Json?     // Array of actionable tasks: ["Send contract", "Followup"]
  internalNotes String?  @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  host    User    @relation(fields: [hostId], references: [id], onDelete: Cascade)

  @@index([hostId])
}

// -------------------------------------------------------------------
// 8. TEAMS & ROUND-ROBIN SCHEDULING
// -------------------------------------------------------------------

model Team {
  id          String   @id @default(cuid())
  ownerId     String
  name        String
  slug        String   @unique
  description String?
  logoUrl     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  owner       User             @relation("TeamOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  members     TeamMember[]
  invitations TeamInvitation[]
  eventTypes  EventType[]

  @@index([slug])
}

model TeamMember {
  id         String   @id @default(cuid())
  teamId     String
  userId     String
  role       TeamRole @default(MEMBER)
  priority   Int      @default(1) // For Round-Robin routing weight
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([teamId, userId])
}

model TeamInvitation {
  id        String   @id @default(cuid())
  teamId    String
  email     String
  role      TeamRole @default(MEMBER)
  priority  Int      @default(1)
  token     String   @unique @default(uuid())
  status    String   @default("PENDING") // PENDING, ACCEPTED, DECLINED, EXPIRED
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  team Team @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@unique([teamId, email])
  @@index([token])
  @@index([email])
}

// -------------------------------------------------------------------
// 9. CONTACT MANAGEMENT (CRM)
// -------------------------------------------------------------------

model Contact {
  id            String    @id @default(cuid())
  userId        String
  name          String
  email         String
  phone         String?
  company       String?
  tags          String[]  @default([])
  notes         String?   @db.Text
  totalBookings Int       @default(1)
  lastMeetingAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, email])
  @@index([userId, email])
}

// -------------------------------------------------------------------
// 10. NOTIFICATION SYSTEM
// -------------------------------------------------------------------

model Notification {
  id           String           @id @default(cuid())
  userId       String
  title        String
  message      String           @db.Text
  type         NotificationType @default(EMAIL)
  isRead       Boolean          @default(false)
  scheduledFor DateTime?
  sentAt       DateTime?
  createdAt    DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

// -------------------------------------------------------------------
// 11. ENTERPRISE AUTOMATION & WORKFLOW ENGINE
// -------------------------------------------------------------------

model Automation {
  id           String      @id @default(cuid())
  userId       String
  name         String
  trigger      TriggerType
  offsetMinutes Int        @default(0) // e.g. -60 = 1 hour before meeting
  isActive     Boolean     @default(true)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workflows Workflow[]

  @@index([userId, isActive])
}

model Workflow {
  id           String     @id @default(cuid())
  automationId String
  stepOrder    Int        @default(1)
  action       ActionType
  template     String     @db.Text // Email/SMS content with variables: {guest_name}, {event_title}
  config       Json?      // Custom headers, webhook URLs, etc.
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  automation Automation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  @@index([automationId, stepOrder])
}

// -------------------------------------------------------------------
// 12. INTEGRATIONS & WEBHOOKS
// -------------------------------------------------------------------

model Integration {
  id          String          @id @default(cuid())
  userId      String
  type        IntegrationType
  credentials Json            // OAuth Tokens & metadata
  isConnected Boolean         @default(true)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

model Webhook {
  id              String   @id @default(cuid())
  userId          String
  name            String
  url             String
  secret          String
  events          String[] // e.g. ["booking.created", "booking.cancelled"]
  isActive        Boolean  @default(true)
  lastTriggeredAt DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// -------------------------------------------------------------------
// 13. ANALYTICS & AUDIT LOGS
// -------------------------------------------------------------------

model Analytics {
  id             String   @id @default(cuid())
  userId         String
  date           DateTime @db.Date
  totalBookings  Int      @default(0)
  completedCount Int      @default(0)
  cancelledCount Int      @default(0)
  conversionRate Float    @default(0.0)
  createdAt      DateTime @default(now())

  @@unique([userId, date])
  @@index([userId, date])
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String
  action    String   // e.g. "EVENT_CREATED", "BOOKING_RESCHEDULED"
  entity    String   // e.g. "Booking", "EventType"
  entityId  String
  metadata  Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}
// -------------------------------------------------------------------
// 14. PASSWORD RESET & EMAIL OTP VERIFICATION
// -------------------------------------------------------------------

model PasswordReset {
  id        String   @id @default(cuid())
  email     String
  otp       String   // 6-digit verification code
  token     String   @unique // Secure reset URL token
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@index([token])
}

// -------------------------------------------------------------------
// 15. SIGNUP EMAIL OTP VERIFICATION
// -------------------------------------------------------------------

model EmailVerification {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  password  String   // Hashed password
  timeZone  String   @default("Asia/Kolkata")
  otp       String   // 6-digit verification code
  expires   DateTime
  createdAt DateTime @default(now())

  @@index([email])
}


// -------------------------------------------------------------------
// 16. ROUTING FORMS & LEAD QUALIFICATION
// -------------------------------------------------------------------

model RoutingForm {
  id                  String              @id @default(cuid())
  userId              String
  title               String
  slug                String              @unique
  description         String?
  fields              Json                // Array of form fields [{ id, label, type, required, options }]
  routes              Json                // Conditional rules [{ id, fieldId, operator, value, destinationType, destinationValue }]
  fallbackDestination Json                // Fallback destination { type, value }
  isActive            Boolean             @default(true)
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  submissions RoutingSubmission[]

  @@index([userId, slug])
}

model RoutingSubmission {
  id              String      @id @default(cuid())
  formId          String
  respondentEmail String?
  answers         Json        // Key-value pairs of responses
  routedTo        String?     // Destination event or URL
  createdAt       DateTime    @default(now())

  form RoutingForm @relation(fields: [formId], references: [id], onDelete: Cascade)

  @@index([formId, createdAt])
}
